**/.git
**/.gitignore
**/.env
**/.env.*
**/MODEL_API_KEY*.txt
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite3
**/*.sqlite-shm
**/*.sqlite-wal
**/*.db
