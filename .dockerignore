**/LICENSE

# IDE files
**/.vscode
**/.idea
**/*.swp
**/*.swo

# OS files
**/.DS_Store
**/Thumbs.db

# Test files
**/*.test.ts
**/*.spec.ts

# Logs
**/*.log
**/npm-debug.log*

# Local runtime data (mounted as volumes)
/backend-go/data/
/backend-go/uploads/
/data/
/uploads/
/backend-go/*.db
/backend-go/*.db-shm
/backend-go/*.db-wal

# Development-only deterministic regression fixtures never enter image builds
/backend-go/internal/services/testdata/regression/

# Clean Slate build context: legacy runtime trees are never sent to this image build.
/backend-go/
/frontend/
/scripts/
/Dockerfile
/docker-compose.yml
/docker-compose.production.yml
/nginx.conf
/supervisord.conf

# The local release candidate is assembled only from apps, contracts and required infra assets.
/docs/
/tests/
/tools/
/apps/web/dist/
/.local-release-cache/
/tests/evaluation/real-local/
/tests/evidence/evaluation/real-local/

# Local secrets and recoverable backups
/.env
/.env.*
/MODEL_API_KEY*.txt
/.tmp_*/
/backend-go/email_password.key
/backup-*/
