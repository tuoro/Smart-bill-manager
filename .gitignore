# Dependencies
/frontend/node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/venv/
/env/
/ENV/

# Build outputs
/frontend/dist/
/build/
*.log

# Environment
/.env
/.env.local
/.env.*.local

# Secrets and local databases at any depth; committed templates stay visible.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
**/MODEL_API_KEY*.txt
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sqlite
**/*.sqlite3
**/*.sqlite-shm
**/*.sqlite-wal
**/*.sqlite.runtime.lock
**/*.sqlite.restore-state
**/.sbm-restore-complete-*
**/*.db
**/*.db-shm
**/*.db-wal
**/.sbm-backup-*/
**/.sbm-restore-database-*/
**/.sbm-restore-objects-*/
**/.sbm-restore-key-*/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test coverage
/coverage/
/backend-go/coverage.out

# Temporary files
/tmp/
/temp/
/.tmp_*/

# Runtime data and uploads; patterns are anchored so source assets remain trackable.
/backend-go/data/
/backend-go/uploads/
/data/
/uploads/

# SQLite sidecars outside the runtime data directories.
/backend-go/*.db
/backend-go/*.db-shm
/backend-go/*.db-wal

# Local keys and recoverable deployment backups.
/backend-go/email_password.key
/MODEL_API_KEY*.txt
/backup-*/

# Local-only real-world model evaluation corpus and raw evidence.
/tests/evaluation/real-local/
/tests/evidence/evaluation/real-local/

# Clean Slate generated artifacts
/apps/web/node_modules/
/apps/web/dist/
/apps/web/coverage/
/apps/web/test-results/
/apps/api/coverage.out
/.local-release-cache/
