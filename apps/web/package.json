{
  "name": "@smart-bill-manager/web",
  "private": true,
  "version": "0.4.0-m4",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "contract": "openapi-typescript ../../contracts/openapi/openapi.yaml -o src/data/generated/api.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:lighthouse": "node e2e/run-lighthouse.mjs",
    "test:responsive": "node e2e/run-responsive-a11y.mjs",
    "build": "npm run contract && npm run typecheck && vite build",
    "check": "npm run contract && npm run typecheck && npm run lint && npm run format:check && npm run test && vite build"
  },
  "dependencies": {
    "vue": "3.5.42",
    "vue-router": "5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.5.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "lighthouse": "13.4.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
