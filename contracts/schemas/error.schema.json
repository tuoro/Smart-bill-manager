{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-bill-manager.local/schemas/error/1",
  "title": "API Error",
  "type": "object",
  "additionalProperties": false,
  "required": ["error", "request_id"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]+$"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "resource_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  }
}
