# local 只用于回环地址验收；经 TLS 暴露时必须改为 production / true。
SBM_DEPLOYMENT_MODE=local
SBM_COOKIE_SECURE=false
SBM_BIND_ADDRESS=127.0.0.1
SBM_HTTP_PORT=8080
SBM_SESSION_TTL=168h
SBM_AI_CONCURRENCY=2

# 由 tools/prepare-local-release-artifacts.mjs 在 /tmp owner-only 隔离目录生成。
# Dockerfile 只读校验身份、精确文件清单和 SHA-256；不得指向 URL 或仓库目录。
SBM_RELEASE_ARTIFACTS_SOURCE=/tmp/replace-with-protected-release-artifacts

# 必须指向仓库外、owner-only 的 32 字节原始、64 位 hex 或 padded base64 文件。
# Compose 只读挂载该文件；主密钥副本必须与数据库、对象和备份分别托管。
SBM_MASTER_KEY_SOURCE=/absolute/path/to/sbm-master-key

# 三个数据库角色必须使用彼此独立、仓库外、owner-only 的随机密码文件。
SBM_POSTGRES_ADMIN_PASSWORD_SOURCE=/absolute/path/to/sbm-postgres-admin-password
SBM_POSTGRES_MIGRATION_PASSWORD_SOURCE=/absolute/path/to/sbm-postgres-migration-password
SBM_POSTGRES_RUNTIME_PASSWORD_SOURCE=/absolute/path/to/sbm-postgres-runtime-password

# 必须替换为当前工作区 `git rev-parse HEAD` 的 40 位小写 SHA。
SBM_BUILD_SHA=replace-with-current-40-character-git-head

# 必须替换为发布检查工具对当前镜像输入计算的 64 位 SHA-256。
SBM_RELEASE_INPUT_SHA256=replace-with-current-64-character-release-input-digest
