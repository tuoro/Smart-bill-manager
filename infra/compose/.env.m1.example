# local 用于回环地址验收；经 TLS 暴露时必须改为 production / true。
SBM_DEPLOYMENT_MODE=local
SBM_COOKIE_SECURE=false
SBM_BIND_ADDRESS=127.0.0.1
SBM_HTTP_PORT=8080
SBM_SESSION_TTL=168h
SBM_AI_CONCURRENCY=2

# 必须指向持久保存的 32 字节原始、64 位 hex 或 padded base64 文件。
# 文件不写入仓库；备份与数据库、对象卷一起受保护。
SBM_MASTER_KEY_SOURCE=/absolute/path/to/sbm-master-key

# 可由验收脚本注入当前工作区 SHA；未提交工作树使用 working-tree。
SBM_BUILD_SHA=working-tree
