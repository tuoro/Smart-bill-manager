  "conclusions": [
    "金额主要失败模式是展示字符串被写入 value、正确最小单位整数被写入 normalized_value；本地权威校验按设计拒绝该输出。",
    "旧 Prompt 的“每个字段都声明 present/absent”未限定为已选文档类型，导致跨类型字段和 unknown 全字段输出。",
    "旧 Prompt 缺少逐路径 value_type 表，导致 money_minor、decimal 与 integer 类型混淆。",
    "Provider 超时与 Schema 失败同时存在；Prompt/输出契约只能修复结构质量，不能把外部延迟伪装为通过。"
  ],
  "frozen_dataset_findings": [
    {
      "code": "payment_order_number_manifest_contradiction",
      "affected_samples": 40,
      "generator_observation": "payment images render ORDER: SYN-PAY-xxxx",
      "manifest_observation": "the same payment samples mark order_number as expected missing",
      "impact": "manifest_assertion_rate is not trustworthy for m1-synthetic-v1; published core-field metrics are unaffected",
      "remediation": "do not edit frozen v1 in place; use an independent tuning set now and publish a new release dataset version before formal release evaluation"
    }
